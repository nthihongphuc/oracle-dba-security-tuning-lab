# ==============================================================================
# Oracle 23ai Free DBA Engineering Lab - Environment Configuration Template
# Copy to `.env` and replace all CHANGE_ME_* placeholders before starting Docker.
# NEVER commit `.env` or real credentials to version control.
# ==============================================================================

# Container & network configuration
ORACLE_CONTAINER_NAME=oracle-lab-01
ORACLE_PORT=1521
ORACLE_PDB=FREEPDB1

# Administrative password for SYS / SYSTEM / PDBADMIN (required by gvenzl/oracle-free)
ORACLE_PASSWORD=CHANGE_ME_SYS_PASSWORD_MIN_12_CHARS

# Application service account bootstrap (optional container convenience user)
APP_USER=HOTEL_BOOTSTRAP
APP_USER_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

# SQL*Plus substitution variables used when executing 01-security scripts
SEC_ADMIN_PWD=CHANGE_ME_SEC_ADMIN_PASSWORD
HOTEL_APP_PWD=CHANGE_ME_HOTEL_APP_PASSWORD
HR_PAYROLL_PWD=CHANGE_ME_HR_PAYROLL_PASSWORD
CLERK_DEMO_PWD=CHANGE_ME_CLERK_DEMO_PASSWORD
AUDITOR_DEMO_PWD=CHANGE_ME_AUDITOR_DEMO_PASSWORD

# TDE reference keystore password (Enterprise Edition / Cloud DB only)
TDE_KEYSTORE_PWD=CHANGE_ME_TDE_WALLET_PASSWORD

# RMAN backup wrapper defaults
ORACLE_SID=FREE
ORACLE_HOME=/opt/oracle/product/23ai/dbhomeFree
RMAN_BACKUP_DIR=/opt/oracle/rman_backups
RMAN_LOG_DIR=/opt/oracle/rman_logs
RMAN_RETENTION_DAYS=7
